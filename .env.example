# Environment Variables for Love Blink Detection App
# Copy this file to .env.local for local development

# Node Environment
NODE_ENV=production

# Server Port (for local development only)
PORT=3000

# API Base URL (for production, this will be handled by Vercel)
NEXT_PUBLIC_API_URL=

# Photo and Music Paths
PHOTOS_PATH=./public/photos
MUSIC_PATH=./public/music

# Blink Detection Settings
BLINK_COOLDOWN_MS=500
TOTAL_PHOTOS=25

# Feature Flags
ENABLE_CAMERA=false
ENABLE_MUSIC=true
