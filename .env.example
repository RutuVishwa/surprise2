# Environment Variables Template
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=3000

# CORS Settings
CORS_ORIGIN=*

# Photo Gallery Settings
PHOTOS_FOLDER=photos
MUSIC_FOLDER=music

# Blink Detection Settings
BLINK_THRESHOLD=0.1
BLINK_COOLDOWN=200

# Logging
LOG_LEVEL=info

# Security
SESSION_SECRET=your-secret-key-here
