{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "templates/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "music/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/get_status",
      "dest": "/api/app.py"
    },
    {
      "src": "/manual_blink",
      "dest": "/api/app.py"
    },
    {
      "src": "/photos/(.*)",
      "dest": "/public/photos/$1"
    },
    {
      "src": "/music/(.*)",
      "dest": "/public/music/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/app.py"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PYTHON_VERSION": "3.9"
  }
}
